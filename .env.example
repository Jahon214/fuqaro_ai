# Fuqaro AI Configuration

# Server Port
PORT=3001

# Fuqaro Boti (Citizen Bot) token from @BotFather
CITIZEN_BOT_TOKEN=

# Admin Boti (Admin / MFY xodimi Boti) token from @BotFather
ADMIN_BOT_TOKEN=

# Admin Telegram Chat ID (yoki admin botga /start bosganda avtomatik ro'yxatga olinadi)
ADMIN_CHAT_ID=

# WebApp URL (Mini App manzili - masalan https://fuqaro-ai.netlify.app yoki ngrok/localtunnel manzili)
WEBAPP_URL=http://localhost:5173

# Google Gemini Free API Key (Ixtiyoriy - https://aistudio.google.com orqali bepul olinadi)
# Bo'sh qoldirilsa ham, tizim o'rnatilgan sun'iy intellekt (Built-in AI Copilot) orqali 100% bepul ishlayveradi.
GEMINI_API_KEY=
