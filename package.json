{
  "name": "xovos-fuqaro-ai",
  "version": "1.0.0",
  "description": "Xovos Fuqaro AI - MFY xodimlari va fuqarolar uchun tavsiya tizimi va Telegram botlari",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "node server/index.js",
    "build:client": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install"
  },
  "keywords": [
    "xovos-fuqaro-ai",
    "telegram-bot",
    "mfy",
    "mahalla",
    "xovos",
    "uzbekistan"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.34.1"
  }
}
